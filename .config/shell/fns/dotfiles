# dotfiles sync — auto-fetch on shell startup, never auto-commit.
#
# On startup (_dotfiles_autocheck, called from .config/shell/rc):
#   - clean tree + behind remote  -> fast-forward apply + restow
#   - uncommitted local changes   -> banner only, no merge (you decide)
#   - diverged / unpushed         -> banner only
#   - up to date                  -> silent
# A throttled fetch runs in the background so the shell never blocks on the network.
#
# Manual command:
#   dotfiles [status]  fetch now + show branch / ahead-behind / working changes,
#                      and Codex model ids a newer release has replaced
#   dotfiles apply     fast-forward apply remote + restow, on demand
#   dotfiles diff      show uncommitted local changes
#   dotfiles stow      stow (or restow) the repo into $HOME; use this, not plain
#                      `stow .`, also for the first install
#
# Override in ~/.zshrc.local / ~/.bashrc.local:
#   DOTFILES_AUTO_SYNC       set 0 to disable startup fetch/apply entirely; the
#                            manual `dotfiles` command still works (default 1)
#   DOTFILES_DIR             (default $HOME/.dotfiles)
#   DOTFILES_FETCH_INTERVAL  seconds between background fetches (default 43200 = 12h)

: "${DOTFILES_DIR:=$HOME/.dotfiles}"
: "${DOTFILES_FETCH_INTERVAL:=43200}"

# Stow the repo into $HOME. Directories that other tools also write into must be
# real directories in $HOME: when one is missing, stow links the whole directory
# into this repo, and whatever the agent CLIs or `systemctl --user enable/edit`
# write there then lands in this public checkout (and its untracked files stop
# the auto-sync). The systemd, environment.d and user-tmpfiles config is
# Linux-only, so other systems skip it.
_dotfiles_stow() {
  _dotfiles_unfold
  ( cd "$DOTFILES_DIR" || exit 1
    for d in $(_dotfiles_real_dirs); do mkdir -p "$HOME/$d"; done
    case "$(uname -s)" in
      Linux)
        stow --restow --target="$HOME" "$@" .
        ;;
      *)
        stow --restow --target="$HOME" --ignore='\.config/systemd' --ignore='\.config/environment\.d' \
          --ignore='\.config/user-tmpfiles\.d' "$@" .
        ;;
    esac
  )
}

# The directories, relative to $HOME, that must not be stow-folded. The agent
# CLIs keep auth tokens, session logs and caches in theirs. On Linux, add the
# three above and every unit drop-in directory here (t3code-.scope.d, ...):
# systemd silently ignores a drop-in directory that is a *relative* symlink,
# which is what stow makes, while a real directory holding stow's relative file
# links works. Parents come first.
_dotfiles_real_dirs() {
  echo .claude
  echo .codex
  echo .codex/skills
  echo .copilot
  echo .gemini
  echo .gemini/config
  [ "$(uname -s)" = Linux ] || return 0
  echo .config/systemd
  echo .config/systemd/user
  echo .config/environment.d
  echo .config/user-tmpfiles.d
  [ -d "$DOTFILES_DIR/.config/systemd/user" ] &&
    ( cd "$DOTFILES_DIR" && find .config/systemd/user -mindepth 1 -maxdepth 1 -type d -name '*.d' )
}

# Remove a stow-folded symlink for those directories: one that resolves to the
# same path inside this repo, which only stow makes. A plain `stow .` (or the
# sync code an older checkout had loaded) creates them when the directory did
# not exist yet, and `mkdir -p` would then just follow the link. Returns 0 when
# it removed one.
_dotfiles_unfold() {
  local repo d removed=1
  repo="$(cd "$DOTFILES_DIR" 2>/dev/null && pwd -P)" || return 1
  for d in $(_dotfiles_real_dirs); do
    [ -L "$HOME/$d" ] || continue
    [ "$(cd "$HOME/$d" 2>/dev/null && pwd -P)" = "$repo/$d" ] || continue
    rm "$HOME/$d" && removed=0
  done
  return $removed
}

_dotfiles_stamp() {
  printf '%s/dotfiles/last-fetch' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

# Throttled, backgrounded fetch. Refreshes origin/* for the *next* shell so the
# current startup never waits on the network.
_dotfiles_maybe_fetch() {
  local stamp; stamp="$(_dotfiles_stamp)"
  local now; now="$(date +%s)"
  local last=0
  [ -f "$stamp" ] && last="$(cat "$stamp" 2>/dev/null || echo 0)"

  if [ "$((now - last))" -lt "$DOTFILES_FETCH_INTERVAL" ]; then
    return 0
  fi

  mkdir -p "$(dirname "$stamp")"
  printf '%s' "$now" >"$stamp"
  ( git -C "$DOTFILES_DIR" fetch -q origin >/dev/null 2>&1 & ) >/dev/null 2>&1
}

# Colored line to stderr, plain when not a tty.
_dotfiles_say() {
  local color="$1"; shift
  if [ -t 2 ]; then
    printf '\033[%sm%s\033[0m\n' "$color" "$*" >&2
  else
    printf '%s\n' "$*" >&2
  fi
}

# Runs on every interactive shell startup. Cheap: only local git plumbing,
# plus a throttled background fetch.
_dotfiles_autocheck() {
  [ -d "$DOTFILES_DIR/.git" ] || return 0

  # Repair a fold left by older sync code (it stowed before this file updated).
  _dotfiles_unfold && _dotfiles_stow >/dev/null 2>&1

  _dotfiles_maybe_fetch

  local upstream
  upstream="$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || return 0
  [ -n "$upstream" ] || return 0

  local porcelain
  porcelain="$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)"

  local behind ahead
  behind="$(git -C "$DOTFILES_DIR" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
  ahead="$(git -C "$DOTFILES_DIR" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"

  if [ -n "$porcelain" ]; then
    local count; count="$(printf '%s\n' "$porcelain" | grep -c .)"
    local header="⚠ dotfiles: $count local change(s)"
    [ "$behind" -gt 0 ] && header="$header (+$behind remote commit(s) waiting)"
    _dotfiles_say 33 "$header"
    printf '%s\n' "$porcelain" | head -10 | sed 's/^/    /' >&2
    [ "$count" -gt 10 ] && printf '    … and %s more\n' "$((count - 10))" >&2
    return 0
  fi

  if [ "$behind" -gt 0 ] && [ "$ahead" -eq 0 ]; then
    if git -C "$DOTFILES_DIR" merge --ff-only "$upstream" >/dev/null 2>&1; then
      _dotfiles_stow >/dev/null 2>&1
      _dotfiles_say 32 "✓ dotfiles: applied $behind remote commit(s)"
    else
      _dotfiles_say 33 "⚠ dotfiles: $behind remote commit(s) could not fast-forward"
    fi
    return 0
  fi

  if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
    _dotfiles_say 33 "⚠ dotfiles: diverged ($behind behind, $ahead ahead)"
    return 0
  fi

  if [ "$ahead" -gt 0 ]; then
    _dotfiles_say 90 "ℹ dotfiles: $ahead unpushed commit(s)"
  fi
}

dotfiles() {
  local repo="$DOTFILES_DIR"

  case "${1:-status}" in
    status|st)
      ( cd "$repo" || return 1
        git fetch -q origin >/dev/null 2>&1
        git status -sb
        local up; up="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
        if [ -n "$up" ]; then
          printf 'behind %s, ahead %s\n' \
            "$(git rev-list --count HEAD.."$up" 2>/dev/null || echo 0)" \
            "$(git rev-list --count "$up"..HEAD 2>/dev/null || echo 0)"
        fi
        if command -v python3 >/dev/null 2>&1 && ! .agents/bin/codex-model-check >/dev/null 2>&1; then
          echo "stale Codex model ids (newer release in the catalog):"
          .agents/bin/codex-model-check | sed 's/^/    /'
        fi
      )
      ;;
    apply|a)
      ( cd "$repo" || return 1
        git fetch -q origin >/dev/null 2>&1
        local up; up="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
        if [ -z "$up" ]; then echo "no upstream configured"; return 1; fi
        if [ -n "$(git status --porcelain)" ]; then
          echo "✗ local changes present — review with 'dotfiles diff' first"; return 1
        fi
        if git merge --ff-only "$up" >/dev/null 2>&1; then
          _dotfiles_stow >/dev/null 2>&1
          echo "✓ applied + restowed"
        else
          echo "✗ not a fast-forward — diverged, resolve manually"; return 1
        fi
      )
      ;;
    diff|d)
      ( cd "$repo" || return 1; git status -s; git diff )
      ;;
    stow|s)
      _dotfiles_stow -v
      ;;
    *)
      echo "usage: dotfiles [status|apply|diff|stow]"
      ;;
  esac
}
