export EDITOR=nvim
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Aspire CLI (installed per-machine via https://aspire.dev/install.sh to
# ~/.aspire/bin). Wired here so both zsh (macOS) and bash (Linux) resolve it;
# harmless when Aspire isn't installed on a given machine.
export PATH="$HOME/.aspire/bin:$PATH"

# opencode: machine-specific settings (e.g. server.cors with a private hostname)
# live in an untracked ~/.config/opencode/local.json, merged over the global config.
[ -f "$HOME/.config/opencode/local.json" ] && export OPENCODE_CONFIG="$HOME/.config/opencode/local.json"

# GitHub Copilot CLI: load the machine-local agent instructions. Copilot has no
# global AGENTS.md or imports; it does load *.instructions.md files under
# <dir>/.github/instructions/ for each dir listed here, so each machine with an
# ~/.agents/AGENTS.local.md links it in (see CLAUDE.md, "Global agent instructions").
export COPILOT_CUSTOM_INSTRUCTIONS_DIRS="$HOME/.agents"

# T3 Code: opt out of product analytics (PostHog) and relay tracing, and keep
# the OpenTelemetry SDK from exporting anything. The desktop app reads
# T3CODE_TELEMETRY_ENABLED from the login shell at startup.
export T3CODE_TELEMETRY_ENABLED=false
export T3CODE_OTEL_SDK_DISABLED=true
